  "_meta": {
    "titulo": "O Caminho do Sambrass — trilha completa (110 peças)",
    "principio": "trilha mestra graded (uma habilidade nova por vez); módulos de ~9 peças; dificuldade = recalibrada 1–10; leitura à 1ª vista pela escada.",
    "carga": "1h30/dia"
  },
  "rotina_diaria": [
    {
      "bloco": "Aquecimento",
      "min": 15,
      "conteudo": "Notas longas (som) + lip slurs + escala do tom da semana. Igual todo dia."
    },
    {
      "bloco": "Célula do dia",
      "min": 20,
      "conteudo": "Snippet que isola a dificuldade-alvo da semana, em loop com metrônomo lento subindo aos poucos."
    },
    {
      "bloco": "Música em foco",
      "min": 35,
      "conteudo": "Decompor a peça da semana seção por seção: ler lento, isolar o compasso difícil, montar."
    },
    {
      "bloco": "Leitura à primeira vista",
      "min": 15,
      "conteudo": "Uma peça NOVA do caderno (nunca vista), lenta, sem parar — treina o objetivo 3."
    },
    {
      "bloco": "Revisão / roda",
      "min": 5,
      "conteudo": "Tocar de cór uma peça já dominada, em andamento de roda."
    }
  ],
